# Local development. Production values live only in the host's reminders-ai.env.
PORT=8792
# DATABASE_URL=postgresql://reminders_ai_runtime:...@127.0.0.1:5432/reminders_ai   # unset = in-memory store
# openssl rand -hex 32
SESSION_SECRET=
APPLE_BUNDLE_ID=com.jimgreco.remindersai
ALLOWED_EMAILS=
# ALLOWED_APPLE_SUBS=
# Simulator only, never in production:
REMINDERS_AI_DEV_SIGNIN=1
# A scripted assistant, so the app can be tried without an API key:
# REMINDERS_AI_FAKE_AGENT=1
# Claude: the API key, and the ids printed by `npm run agent:setup`.
# ANTHROPIC_API_KEY=
# AGENT_ID=
# AGENT_ENVIRONMENT_ID=
# Spending cap per agent session in cents at list prices (default 500, 0 = none).
# SESSION_BUDGET_CENTS=500
# Push notifications (APNs token key). All three or none.
# APNS_KEY_ID=
# APNS_TEAM_ID=V6JPQCD336
# APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# TRUST_PROXY_HOPS=1
